<!--
  MJCF model of the 6DOF arm. Values from docs/arm-dimensions.md, converted to metres.

  Frame: origin on the board top under the S1 axis, Z up, Y toward the front of the board,
  X along the 30 cm edge (same as the Blender setup).

  Zero pose: all links stacked straight up. This is a modelling pose, not the servo home pose.
  Joint signs: positive S2, S3, S4 tilt the arm toward +Y; positive S1 turns +Y toward +X.

  Only link lengths, gripper gap and cube size are measured. Masses, link radii, joint
  ranges and actuator gains are placeholders.
-->
<mujoco model="px_robotic_arm">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <!-- Arm links do not collide; only the finger pads, the board and the cube do. -->
    <geom contype="0" conaffinity="0" rgba="0.15 0.16 0.18 1"/>
    <position kp="20" ctrllimited="true"/>
  </default>

  <worldbody>
    <light pos="0 0.2 1" dir="0 0 -1"/>

    <!-- Board 30 x 38, centre 17,5 in front of S1. Thickness not measured, 1 cm placeholder. -->
    <geom name="board" type="box" size="0.15 0.19 0.005" pos="0 0.175 -0.005"
          contype="1" conaffinity="1" rgba="0.85 0.82 0.75 1"/>

    <!-- Test cube 2,65 cm, starting at the example position of docs/pick-and-place-plan.md. -->
    <body name="cube" pos="0.05 0.15 0.01325">
      <freejoint/>
      <geom name="cube" type="box" size="0.01325 0.01325 0.01325" mass="0.01"
            contype="1" conaffinity="1" friction="1.5 0.01 0.001" rgba="0.85 0.2 0.2 1"/>
    </body>

    <!-- S1 base rotation. Board top to S2 axis: 9,6. -->
    <body name="base" pos="0 0 0">
      <joint name="s1_base" type="hinge" axis="0 0 -1" range="-100 100"/>
      <geom type="cylinder" fromto="0 0 0 0 0 0.096" size="0.03" mass="0.3"/>

      <!-- S2 shoulder to S3 elbow: 10,5 -->
      <body name="upper_arm" pos="0 0 0.096">
        <joint name="s2_shoulder" type="hinge" axis="-1 0 0" range="-120 120"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.105" size="0.012" mass="0.12"/>

        <!-- S3 elbow to S4 wrist flexion: 12,6 -->
        <body name="forearm" pos="0 0 0.105">
          <joint name="s3_elbow" type="hinge" axis="-1 0 0" range="-150 150"/>
          <geom type="capsule" fromto="0 0 0 0 0 0.126" size="0.01" mass="0.1"/>

          <!-- S4 wrist flexion to gripper flange: 6,7 (includes the S5 servo body) -->
          <body name="wrist" pos="0 0 0.126">
            <joint name="s4_wrist_flex" type="hinge" axis="-1 0 0" range="-150 150"/>
            <geom type="capsule" fromto="0 0 0 0 0 0.067" size="0.012" mass="0.08"/>

            <!-- S5 wrist rotation around the link axis; the flange is the reference point. -->
            <body name="hand" pos="0 0 0.067">
              <joint name="s5_wrist_rot" type="hinge" axis="0 0 1" range="-120 120"/>
              <geom type="box" size="0.032 0.008 0.012" pos="0 0 0.012" mass="0.06"/>
              <site name="flange" size="0.004" rgba="0 0.6 1 1"/>
              <!-- Centre of a held cube: 11,0 from the flange. -->
              <site name="grasp" pos="0 0 0.110" size="0.004" rgba="0 1 0.4 1"/>

              <!-- Fingers simplified to two slides along local X (the real gripper is a
                   parallel linkage, so the pads also move without turning).
                   Slide 0 = open, gap 4,5; slide 0,0225 = pads touch. -->
              <body name="finger_left" pos="-0.0225 0 0">
                <joint name="s6_finger_left" type="slide" axis="1 0 0" range="0 0.0225"/>
                <geom type="box" size="0.002 0.004 0.05" pos="-0.002 0 0.06" mass="0.01"/>
                <geom name="pad_left" type="box" size="0.00135 0.01 0.006" pos="0.00135 0 0.110"
                      contype="1" conaffinity="1" friction="1.5 0.01 0.001" rgba="0.9 0.9 0.9 1" mass="0.002"/>
              </body>
              <body name="finger_right" pos="0.0225 0 0">
                <joint name="s6_finger_right" type="slide" axis="-1 0 0" range="0 0.0225"/>
                <geom type="box" size="0.002 0.004 0.05" pos="0.002 0 0.06" mass="0.01"/>
                <geom name="pad_right" type="box" size="0.00135 0.01 0.006" pos="-0.00135 0 0.110"
                      contype="1" conaffinity="1" friction="1.5 0.01 0.001" rgba="0.9 0.9 0.9 1" mass="0.002"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- Both fingers move together, like the meshing gears. -->
    <joint joint1="s6_finger_right" joint2="s6_finger_left"/>
  </equality>

  <actuator>
    <position name="s1" joint="s1_base" ctrlrange="-1.745 1.745"/>
    <position name="s2" joint="s2_shoulder" ctrlrange="-2.094 2.094"/>
    <position name="s3" joint="s3_elbow" ctrlrange="-2.618 2.618"/>
    <position name="s4" joint="s4_wrist_flex" ctrlrange="-2.618 2.618"/>
    <position name="s5" joint="s5_wrist_rot" ctrlrange="-2.094 2.094"/>
    <!-- 0 = open, 0,0225 = closed. Holding the cube: 0,00925 per finger. -->
    <position name="s6" joint="s6_finger_left" ctrlrange="0 0.0225" kp="50"/>
  </actuator>
</mujoco>
